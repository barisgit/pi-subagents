{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noControlCharactersInRegex": "warn"
			}
		}
	},
	"assist": {
		"enabled": false
	},
	"files": {
		"includes": ["index.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "*.mjs"]
	}
}
